{
  "name": "madbrain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "setup:pinecone": "node scripts/setup-pinecone.mjs",
    "verify:sql": "node scripts/verify-sql.mjs",
    "verify:ingest": "node --conditions=react-server scripts/verify-ingest.mjs",
    "verify:fitcheck": "node scripts/verify-fitcheck.mjs",
    "verify": "npm run verify:sql && npm run verify:ingest && npm run verify:fitcheck && npm run verify:embed && npm run verify:urlguard",
    "verify:embed": "node --conditions=react-server scripts/verify-embed.mjs",
    "verify:urlguard": "node scripts/verify-url-guard.mjs",
    "verify:pinecone": "node --conditions=react-server --import ./scripts/alias-hooks.mjs scripts/verify-pinecone.mjs",
    "verify:openrouter": "node --conditions=react-server --import ./scripts/alias-hooks.mjs scripts/verify-openrouter.mjs",
    "verify:e2e": "node --conditions=react-server --import ./scripts/alias-hooks.mjs scripts/verify-e2e.mjs",
    "verify:access": "node --conditions=react-server --import ./scripts/alias-hooks.mjs scripts/verify-access.mjs",
    "seed:madarth": "node --conditions=react-server --import ./scripts/alias-hooks.mjs scripts/seed-madarth.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/react": "^4.0.50",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@vercel/blob": "^2.6.1",
    "ai": "^7.0.47",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4"
  }
}
